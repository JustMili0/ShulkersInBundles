{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "shulkersinbundles",
    "version": "${mod_version}",
    "metadata": {
      "name": "Shulkers In Bundles",
      "description": "Making bundles a little bit more convenient and useful by allowing to put shulkers in them",
      "contributors": {
        "JustMili": "Author"
      },
      "icon": "icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "net.justmili.quilt.AlwaysShieldQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": [
          "1.21.2",
          "1.21.3",
          "1.21.4",
          "1.21.5",
          "1.21.6",
          "1.21.7",
          "1.21.8",
          "1.21.9",
          "1.21.10",
          "1.21.11"
        ]
      }
    ]
  },
  "mixin": [
    "shulkersinbundles.mixins.json"
  ]
}
